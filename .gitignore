# ── Ware IoT ────────────────────────────────────────────────────────────
# Chave de assinatura da Play Store e suas senhas: NUNCA no git. Perder a
# chave de upload = pedir redefinição ao Google; vazar = alguém publica como
# a Celiware. Guardar no cofre (ver docs/PUBLICACAO.md).
android/key.properties
*.jks
*.keystore
# Ambiente Python isolado do simulador (recriado com requirements.txt).
sim/.venv/
__pycache__/
# Projetos exportados durante teste.
*.ihm.json

# Dependências dos geradores (npm install em tool/)
tool/node_modules/

# Vídeo de apresentação: intermediários e saída (regeráveis)
tool/video/.trabalho/
tool/video/saida/
sim/.comando

# Cópias de trabalho dos agentes do Claude Code (worktrees) — nunca vão para o git.
.claude/
tool/site/saida/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Word gerado da ARQUITETURA (node tool/gerar_docx.js); não versionar
docs/*.docx
