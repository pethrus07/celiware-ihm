<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Modbus TCP é socket de rede: sem esta permissão NO MANIFESTO PRINCIPAL
         o app de loja (release) não conecta em nada. Nos apps anteriores
         (machine_monitor, InoRobot) ela só existia no manifesto de debug —
         funcionava no teste e morreria na Play Store. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Saber se o Wi-Fi caiu, para a mensagem certa ao operador. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Vincular as conexões à rede Wi-Fi/cabo da máquina quando ela não tem
         internet e os dados móveis estão ligados (RedeLocal.kt). Permissão
         normal: o Android não pergunta nada ao usuário. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>

    <application
        android:label="Ware IoT"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Avisos por voz (flutter_tts): no Android 11+ o app só enxerga o
             motor de conversão de texto em voz se declarar que procura por ele.
             Sem isto, TextToSpeech não acha motor nenhum e o fone fica mudo. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
