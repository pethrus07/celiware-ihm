<?xml version="1.0" encoding="utf-8"?>
<!-- Backup na nuvem do Android 12 em diante (android:dataExtractionRules).
     Mesmo motivo de backup_rules.xml: o histórico dos registros não sobe (o
     teto de 25 MB derrubaria o backup do projeto junto). Na troca de aparelho
     por cabo ou Wi-Fi não há teto, então ele vai junto. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/registros/" />
    </cloud-backup>
</data-extraction-rules>
